digraph SpookySeason {
    graph [
        rankdir=BT
        splines=ortho
        fontname="DejaVu Sans"
        fontsize=16
        label="Taller 03 — Spooky Season\nDiagrama de clases"
        labelloc=t
        pad=0.4
        nodesep=0.45
        ranksep=0.7
        bgcolor="white"
    ]
    node [
        shape=plaintext
        fontname="DejaVu Sans"
        fontsize=11
    ]
    edge [
        fontname="DejaVu Sans"
        fontsize=9
        color="#334155"
    ]

    Main [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#0F172A">
            <TR><TD BGCOLOR="#FEF3C7"><B>Main</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ main(args)<BR/>entrada, menús y archivos</TD></TR>
        </TABLE>>]
    Sistema [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#0F172A">
            <TR><TD BGCOLOR="#FDE68A"><B>Sistema</B></TD></TR>
            <TR><TD ALIGN="LEFT">- monstruos: ArrayList<BR/>- jugadores: ArrayList<BR/>- historial: LinkedList<BR/>+ registrarMonstruo()<BR/>+ iniciarSesion()<BR/>+ confirmarJugada()<BR/>+ terminarSesion()</TD></TR>
        </TABLE>>]
    ResultadoJugada [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#FEF3C7"><B>ResultadoJugada</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ puntaje<BR/>+ efectiva</TD></TR>
        </TABLE>>]
    ResultadoSesion [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#FEF3C7"><B>ResultadoSesion</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ superoRecord<BR/>+ debeGuardar</TD></TR>
        </TABLE>>]

    Monstruo [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#0F172A">
            <TR><TD BGCOLOR="#DBEAFE"><I><B>Monstruo</B></I></TD></TR>
            <TR><TD ALIGN="LEFT">- vida, velocidad<BR/>- fuerza, resistencia<BR/>+ describir()<BR/><I>+ aceptar(visitor): double</I><BR/><I>+ getTipo(): String</I></TD></TR>
        </TABLE>>]
    Zombi [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#DCFCE7"><B>Zombi</B></TD></TR>
            <TR><TD ALIGN="LEFT">- fuerzaMordida<BR/>+ morder()<BR/>+ regenerarse()</TD></TR>
        </TABLE>>]
    Vampiro [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#DCFCE7"><B>Vampiro</B></TD></TR>
            <TR><TD ALIGN="LEFT">- velocidadVuelo<BR/>- resistenciaSol<BR/>+ morder()<BR/>+ volar()</TD></TR>
        </TABLE>>]
    Momia [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#DCFCE7"><B>Momia</B></TD></TR>
            <TR><TD ALIGN="LEFT">- longitudVendajes<BR/>+ regenerarse()<BR/>+ enfurecerse()</TD></TR>
        </TABLE>>]
    HombreLobo [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#DCFCE7"><B>HombreLobo</B></TD></TR>
            <TR><TD ALIGN="LEFT">- ferocidad<BR/>- faseLunar<BR/>+ morder()<BR/>+ enfurecerse()</TD></TR>
        </TABLE>>]

    Mordedor [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#E0E7FF"><I>«interface»<BR/><B>Mordedor</B></I></TD></TR>
            <TR><TD ALIGN="LEFT">+ morder(): String</TD></TR>
        </TABLE>>]
    Volador [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#E0E7FF"><I>«interface»<BR/><B>Volador</B></I></TD></TR>
            <TR><TD ALIGN="LEFT">+ volar(): String</TD></TR>
        </TABLE>>]
    Regenerable [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#E0E7FF"><I>«interface»<BR/><B>Regenerable</B></I></TD></TR>
            <TR><TD ALIGN="LEFT">+ regenerarse(): String</TD></TR>
        </TABLE>>]
    Furioso [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#E0E7FF"><I>«interface»<BR/><B>Furioso</B></I></TD></TR>
            <TR><TD ALIGN="LEFT">+ enfurecerse(): String</TD></TR>
        </TABLE>>]
    Habilidad [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#EDE9FE"><I>«enum»<BR/><B>Habilidad</B></I></TD></TR>
            <TR><TD ALIGN="LEFT">MORDER, VOLAR<BR/>REGENERARSE<BR/>ENFURECERSE, NINGUNA</TD></TR>
        </TABLE>>]

    VisitorMinijuego [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#FFEDD5"><I>«interface»<BR/><B>VisitorMinijuego</B></I></TD></TR>
            <TR><TD ALIGN="LEFT">+ visitar(Zombi)<BR/>+ visitar(Vampiro)<BR/>+ visitar(Momia)<BR/>+ visitar(HombreLobo)</TD></TR>
        </TABLE>>]
    Minijuego [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#FFEDD5"><I>«interface»<BR/><B>Minijuego</B></I></TD></TR>
            <TR><TD ALIGN="LEFT">+ getNombre()<BR/>+ getHabilidadPremiada()<BR/>+ calcularPotencial()</TD></TR>
        </TABLE>>]
    MinijuegoAbstracto [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#FED7AA"><I><B>MinijuegoAbstracto</B></I></TD></TR>
            <TR><TD ALIGN="LEFT">+ calcularPotencial()<BR/>delega en aceptar()</TD></TR>
        </TABLE>>]
    Carrera [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#FFEDD5"><B>CarreraCementerio</B></TD></TR>
            <TR><TD ALIGN="LEFT">premia VOLAR<BR/>4 fórmulas</TD></TR>
        </TABLE>>]
    Caza [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#FFEDD5"><B>CazaCalabazas</B></TD></TR>
            <TR><TD ALIGN="LEFT">premia MORDER<BR/>4 fórmulas</TD></TR>
        </TABLE>>]
    Lapidas [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#FFEDD5"><B>LanzamientoLapidas</B></TD></TR>
            <TR><TD ALIGN="LEFT">premia ENFURECERSE<BR/>4 fórmulas</TD></TR>
        </TABLE>>]
    Amanecer [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#FFEDD5"><B>SobrevivirAmanecer</B></TD></TR>
            <TR><TD ALIGN="LEFT">premia REGENERARSE<BR/>4 fórmulas</TD></TR>
        </TABLE>>]

    Jugador [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#FCE7F3"><B>Jugador</B></TD></TR>
            <TR><TD ALIGN="LEFT">- nombre<BR/>- puntaje<BR/>+ setPuntaje()</TD></TR>
        </TABLE>>]
    EntradaHistorial [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#FCE7F3"><B>EntradaHistorial</B></TD></TR>
            <TR><TD ALIGN="LEFT">- minijuego<BR/>- monstruo<BR/>- habilidad<BR/>- puntaje</TD></TR>
        </TABLE>>]

    Zombi -> Monstruo [arrowhead=empty]
    Vampiro -> Monstruo [arrowhead=empty]
    Momia -> Monstruo [arrowhead=empty]
    HombreLobo -> Monstruo [arrowhead=empty]

    Zombi -> Mordedor [style=dashed, arrowhead=empty]
    Zombi -> Regenerable [style=dashed, arrowhead=empty]
    Vampiro -> Mordedor [style=dashed, arrowhead=empty]
    Vampiro -> Volador [style=dashed, arrowhead=empty]
    Momia -> Regenerable [style=dashed, arrowhead=empty]
    Momia -> Furioso [style=dashed, arrowhead=empty]
    HombreLobo -> Mordedor [style=dashed, arrowhead=empty]
    HombreLobo -> Furioso [style=dashed, arrowhead=empty]

    Carrera -> MinijuegoAbstracto [arrowhead=empty]
    Caza -> MinijuegoAbstracto [arrowhead=empty]
    Lapidas -> MinijuegoAbstracto [arrowhead=empty]
    Amanecer -> MinijuegoAbstracto [arrowhead=empty]
    MinijuegoAbstracto -> Minijuego [arrowhead=empty]
    Minijuego -> VisitorMinijuego [arrowhead=empty, label="extiende"]

    Monstruo -> VisitorMinijuego [style=dashed, arrowhead=open, label="aceptar"]
    Minijuego -> Habilidad [style=dashed, arrowhead=open, label="premia"]

    Main -> Sistema [arrowhead=open, label="usa"]
    Sistema -> ResultadoJugada [arrowhead=open, style=dashed]
    Sistema -> ResultadoSesion [arrowhead=open, style=dashed]
    Sistema -> Monstruo [arrowhead=open, label="1..*"]
    Sistema -> Jugador [arrowhead=open, label="1..*"]
    Sistema -> Minijuego [arrowhead=open, label="4"]
    Sistema -> EntradaHistorial [arrowhead=open, label="historial"]

    {rank=same; Mordedor; Volador; Regenerable; Furioso; Habilidad}
    {rank=same; Zombi; Vampiro; Momia; HombreLobo}
    {rank=same; Carrera; Caza; Lapidas; Amanecer}
    {rank=same; Main; Sistema; Jugador}
}
